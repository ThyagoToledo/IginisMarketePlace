# Banco PostgreSQL/Neon. Use apenas credenciais locais ou do ambiente de deploy.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth.js / GitHub OAuth.
AUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
AUTH_GITHUB_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
AUTH_GITHUB_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET

# Lista separada por vírgulas de logins GitHub autorizados como administradores.
ADMIN_GITHUB_LOGINS=YOUR_GITHUB_USERNAME

# Opcional: aumenta o limite das consultas públicas à API do GitHub.
GITHUB_TOKEN=YOUR_OPTIONAL_GITHUB_TOKEN

# Opcional: URL pública da página de doações.
NEXT_PUBLIC_DONATION_URL=https://example.com/donate
